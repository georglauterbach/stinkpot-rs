{
  "name": "default",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/georglauterbach/dev-container-features/lang-rust:0.5": {},
    "ghcr.io/georglauterbach/dev-container-features/lang-sh:0.6": {}
  },
  "containerUser": "user",
  "remoteUser": "user",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "edwinhuish.better-comments-next"
      ],
      "settings": {
        // * extensions::vadimcn.vscode-lldb
        "lldb.launch.preRunCommands": [
          "command script import ${containerEnv:RUST_PRETTIFIER_FOR_LLDB_FILE}"
        ]
      }
    }
  },
  "runArgs": [
    // for compatibility with Podman
    // > https://github.com/devcontainers/features/issues/1480
    "--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777"
  ]
}
